<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.flashticket</groupId>
    <artifactId>flashticket-backend</artifactId>
    <!-- TÓPICO: Versionamento Semântico (SemVer: MAJOR.MINOR.PATCH) -->
    <!-- 0.1.0-SNAPSHOT indica versão em desenvolvimento da primeira entrega (Fase 1) -->
    <version>0.1.0-SNAPSHOT</version>
    <name>FlashTicket Backend</name>
    <description>Plataforma de Eventos, Ingressos e Pagamentos para treinamento completo de Engenharia Backend</description>

    <properties>
        <java.version>21</java.version>
        <!-- Centralização de versões de bibliotecas externas para evitar Dependency Hell -->
        <commons-lang3.version>3.17.0</commons-lang3.version>
    </properties>

    <!-- ========================================================================= -->
    <!-- TÓPICO: INFERNO DE DEPENDÊNCIAS (Dependency Hell) - Solução #1: BOM       -->
    <!-- O bloco <dependencyManagement> fixa qual versão exata deve vencer quando  -->
    <!-- múltiplas bibliotecas transitivas puxam versões diferentes do mesmo JAR.   -->
    <!-- ========================================================================= -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring Boot Web (API RESTful) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Bean Validation (Validação de DTOs de entrada) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Actuator (Health Checks e Métricas de Memória/GC) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ===================================================================== -->
        <!-- TÓPICO: INFERNO DE DEPENDÊNCIAS - Solução #2: <exclusions>            -->
        <!-- Exemplo real: quando uma biblioteca traz uma dependência transitiva   -->
        <!-- legada ou conflitante (ex: commons-logging conflitando com SLF4J),    -->
        <!-- usamos <exclusions> para podar a árvore de dependências.              -->
        <!-- ===================================================================== -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Lombok para reduzir boilerplate -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Testes Automatizados -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- ================================================================= -->
            <!-- TÓPICO: INFERNO DE DEPENDÊNCIAS - Solução #3: Maven Enforcer      -->
            <!-- Detecta automaticamente duplicatas no pom.xml e exige versões     -->
            <!-- mínimas de Java/Maven durante o build.                            -->
            <!-- ================================================================= -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-versions-and-ban-duplicates</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <banDuplicatePomDependencyVersions/>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
